@page "/"
@using DevOps.App.Services;
@inject IBase64Encoder encoder

<div class="d-flex flex-column gap-8 p-4">
    <div class="d-flex flex-column gap-2">
        <label for="@(nameof(DecodedText))" class="fs-3 fw-bold">Codificar para Base64</label>
        <span class="fs-6">Digite no campo a baixo o texto a ser codificado</span>
        <InputTextArea class="min-h-200px" @bind-Value="@DecodedText" @bind-Value:after="@(() => Encode())"></InputTextArea>
    </div>
    <div class="d-flex flex-column gap-2">
        <label for="@(nameof(EncodedText))" class="fs-3 fw-bold">Decodificar para texto puro</label>
        <span class="fs-6">Digite no campo a baixo o texto a ser decodificado</span>
        <InputTextArea class="min-h-200px" @bind-Value="@EncodedText" @bind-Value:after="@(() => Decode())"></InputTextArea>
        @if (!string.IsNullOrWhiteSpace(this.ErrorMessage))
        {
            <span class="text-danger">@this.ErrorMessage</span>
        }
    </div>
</div>

@code {
    private string? EncodedText { get; set; } = string.Empty;

    private string? DecodedText { get; set; } = string.Empty;

    private string? ErrorMessage { get; set; } = string.Empty;

    private string Encode()
    {
        var base64Encoded = encoder.Encode(this.DecodedText);
        this.EncodedText = base64Encoded;
        this.ErrorMessage = string.Empty;
        return base64Encoded;
    }

    private string Decode()
    {
        try
        {
            var result = encoder.Decode(this.EncodedText);
            this.DecodedText = result;
            this.ErrorMessage = string.Empty;
            return result;
        }
        catch (Exception)
        {
            this.ErrorMessage = "Erro! O valor informado não pode ser decodificado, pois seu formato é inválido.";
            this.DecodedText = string.Empty;
            return string.Empty;
        }

    }
}