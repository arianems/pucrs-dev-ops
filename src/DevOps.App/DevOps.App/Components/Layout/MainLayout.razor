@inherits LayoutComponentBase
@inject NavigationManager navigationManager

<div class="page bg-dark">
    <main>
        <div class="top-row px-4">
            @if (this.navigationManager.Uri.Contains("/about") || this.navigationManager.Uri.Contains("/not-found") || this.navigationManager.Uri.Contains("/error"))
            {
                <a href="/">Página Inicial</a>
            }
            else
            {
                <a href="/about">Sobre</a>
            }
        </div>

        <div class="content px-4">
            @Body
        </div>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Oops! Algo errado aconteceu!
    <a href="." class="reload">Recarregar</a>
    <span class="dismiss">🗙</span>
</div>
